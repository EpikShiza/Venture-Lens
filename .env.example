# =====================================================================
# VentureLens Environment Configuration Example
# Copy this file to .env and adjust variables as needed:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux/macOS:        cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# AI INFERENCE PROVIDER
# Options: "mock" (default, zero keys required), "gemini", or "ollama"
# ---------------------------------------------------------------------
AI_PROVIDER=mock

# ---------------------------------------------------------------------
# GOOGLE GEMINI / GEMMA CONFIGURATION
# Required ONLY if AI_PROVIDER=gemini
# Obtain free key at: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------
GEMINI_API_KEY=replace_with_your_actual_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------
# LOCAL OLLAMA CONFIGURATION
# Required ONLY if AI_PROVIDER=ollama
# ---------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# ---------------------------------------------------------------------
# MARKET SEARCH PROVIDER
# Options: "duckduckgo" (default, live search, NO keys required), "tavily", "mock"
# ---------------------------------------------------------------------
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=replace_with_your_tavily_api_key_if_using_tavily

# ---------------------------------------------------------------------
# DATABASE PERSISTENCE
# Default: Local SQLite database in project root
# ---------------------------------------------------------------------
DATABASE_URL=sqlite:///./venturelens.db

# ---------------------------------------------------------------------
# ENGINE TIMEOUTS (Seconds)
# ---------------------------------------------------------------------
AI_TIMEOUT_SECONDS=45
SEARCH_TIMEOUT_SECONDS=15
